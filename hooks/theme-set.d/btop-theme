#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OMABLOT_I18N_BOOT="${OMABLOT_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OMABLOT_I18N_BOOT" ]] || OMABLOT_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ -f "$OMABLOT_I18N_BOOT" ]]; then
    . "$OMABLOT_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi

if command -v omarchy &>/dev/null; then
    omarchy restart btop 2>/dev/null || warn "hooks.btop_restart_failed"
fi